#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/apps/*/android/app/debug
/apps/*/android/app/profile
/apps/*/android/app/release
# Android release signing: the keystore and its passwords stay out of git
/apps/dzep-mobile/android/key.properties
*.jks
*.keystore

# Widget Preview related
.widget_preview/

# FVM Version Cache
.fvm/
# Supabase CLI state
/apps/dzep-macos-app/supabase/.temp/
# Secrets for the CLI and local functions (apps/dzep-macos-app/tool/setup-backend.sh, docs/BUILDING.md)
/apps/dzep-macos-app/supabase/.env
/apps/dzep-macos-app/supabase/.env.local
# Your own signing identity (config/Local.xcconfig.example)
config/Local.xcconfig
